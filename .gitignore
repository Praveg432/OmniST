# Large raw data (NOT committed; fetched via documented sources — see data/README.md).
# Small required inputs (Delhi CSVs, weather npz, PeMS adjacency/coords) ARE committed so the
# headline experiments reproduce out of the box.
# NOTE: git does not allow trailing inline comments on pattern lines — keep comments on their own line.
# pemsbay_vel.csv ~81 MB (full PeMS-BAY speed series), pemsd7_vel.csv ~69 MB
data/real_pems/pemsbay_vel.csv
data/real_pems/pemsd7_vel.csv
# UCI PRSA raw archives + per-station CSVs (~40 MB) + stray image
data/real_beijing/*.zip
data/real_beijing/PRSA_Data_*/
data/real_beijing/*.JPG
# legacy placeholder dirs
data/delhi_air_quality/*.csv
data/delhi_air_quality/*.parquet
data/pems_bay/*.csv
data/pems_bay/*.h5
data/pems_bay/*.npz
!**/.gitkeep

